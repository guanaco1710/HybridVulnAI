# Copia este fichero a .env (cp .env.example .env), rellénalo y protégelo: chmod 600 .env.
# El .env está en .gitignore; nunca lo subas a GitHub.
# Sin API_KEY_IA se usa Ollama; si Ollama tampoco está, solo se guarda el XML de nmap.

# Clave de la IA online (Anthropic, OpenAI, Gemini o Groq)
API_KEY_IA=
# anthropic | openai | gemini | groq. Opcional: si se omite se deduce del prefijo de la clave
PROVEEDOR_IA=
# Opcional: modelo a usar (si se omite, uno por defecto del proveedor)
MODELO_IA=
